# Semgrep exclusions. Each line has a reason. Scan what ships or builds the product, not what is generated or vendored.

# Build output. Generated from src/ by Vite and scripts/postbuild.mjs; the source is scanned instead.
# (The generated service worker, dist/sw.js, is scanned on purpose in a separate run: see docs/SECURITY-SCAN.md.)
dist/

# Third-party code. Audited with `npm audit --omit=dev`, not with Semgrep.
node_modules/

# QA output (screenshots, JSON results, the contact sheet). Produced by Playwright, not shipped.
qa/

# Generated by `npm run gen` from scripts/gen-scenario.ts. The generator is scanned instead.
src/generated/

# Scenario data and the real-data status file: JSON numbers, no code.
public/data/

# Fonts, audio and images: binary, nothing to analyse.
public/fonts/
public/audio/
public/*.jpg
public/*.svg

# Test vectors and fixtures are deliberately malformed or synthetic inputs, including fake codes that look like secrets.
tests/vectors/
tests/fixtures/

# A generated explainer HTML and its tool receipts (tracked, not shipped in the site).
.archify/

# Replay raw data and local tooling output (git-ignored).
data/replay/raw/
data/real/
saboot-qr.svg
